# Copy to databricks.env and fill in. Load it from the repo root, in the shell where you run terraform:
#   source clouds/use.sh databricks
DATABRICKS_HOST=https://<your-workspace-url>
DATABRICKS_TOKEN=

# Read by Terraform as var.<name> (declare each in variables.tf).
# The provider never uses these; they are for naming resources.
TF_VAR_workspace_name=
TF_VAR_catalog_name=
TF_VAR_schema_name=vidpipe
