# Copy to .env (gitignored) before `docker compose up -d`. Throwaway local credentials.
S3_ACCESS_KEY=vidpipeaccess
S3_SECRET_KEY=vidpipesecret123
S3_BUCKET=vidpipe
S3_ENDPOINT=http://localhost:9000

POSTGRES_USER=vidpipe
POSTGRES_PASSWORD=vidpipe
POSTGRES_DB=vidpipe

# Summary LLM (served by Ollama on the host; not part of docker compose). Optional overrides:
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b

# Embedding model for the chunks (the vector size follows the model; search uses the same one). Optional:
# EMBED_MODEL=BAAI/bge-small-en-v1.5
